# Kopieer naar .env en pas aan. Niets hiervan is verplicht.

# LLM-provider: none | groq | gemini | openrouter | ollama | anthropic (betaald)
KR_LLM_PROVIDER=none

# Gratis API-sleutels (alleen nodig voor de gekozen provider):
# GROQ_API_KEY=...        https://console.groq.com
# GEMINI_API_KEY=...      https://aistudio.google.com
# OPENROUTER_API_KEY=...  https://openrouter.ai

# Optioneel ander model per niveau (anders de standaard van de provider):
# KR_LLM_MODEL_ANALYSIS=
# KR_LLM_MODEL_EXTRACTION=
# KR_LLM_MODEL_SCREENING=

# Embedder voor duplicaatcontrole: auto | fastembed | hashing
KR_EMBEDDER=auto

# Maximum aantal LLM-aanroepen per run (gratis versies hebben daglimieten)
KR_MAX_LLM_CALLS_PER_RUN=300

# Webzoeken voor marktonderzoek: none | searxng | tavily
KR_SEARCH_PROVIDER=none
# KR_SEARXNG_URL=http://localhost:8888
# TAVILY_API_KEY=...      https://tavily.com (gratis versie)
# Officiële open data (Eurostat): true | false
KR_USE_OPEN_DATA=true

KR_DATABASE_URL=sqlite:///kansenradar.db
